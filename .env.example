# ==============================
# Copilot library environment
# ==============================

# --- Server runtime ---
# Clients calling the server must send: Authorization: Bearer <API_KEY>
API_KEY=

# GitHub token for local/standalone Copilot SDK sessions (and server-side Copilot client).
GITHUB_TOKEN=

# --- Test runtime ---
# Set to 0 to skip integration suites. Any other value (or unset) runs them.
COPILOT_INTEGRATION=1

# Model ID used in integration tests.
COPILOT_MODEL=gpt-4.1

# Base URL for HTTP integration tests. Leave empty to skip HTTP integration suite.
COPILOT_HTTP_BASE_URL=http://localhost:3000
