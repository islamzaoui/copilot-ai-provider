{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^dev"]
		},
		"build": {
			"dependsOn": ["^build"]
		},
		"start": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^start", "build"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"dependsOn": ["^test"]
		}
	}
}
