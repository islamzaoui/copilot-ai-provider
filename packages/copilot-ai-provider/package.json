{
	"name": "copilot-ai-provider",
	"description": "A custom ai-sdk provider for the GitHub Copilot",
	"version": "0.2.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "bunup --watch",
		"build": "bunup",
		"start": "bun dist/server/index.js",
		"typecheck": "tsc --noEmit",
		"test": "bun test ./test"
	},
	"dependencies": {
		"@ai-sdk/provider": "3.0.8"
	},
	"devDependencies": {
		"bunup": "0.16.29",
		"hono": "4.8.3",
		"zod": "4.3.6"
	},
	"peerDependencies": {
		"typescript": "^5",
		"ai": "catalog:",
		"@github/copilot-sdk": "catalog:"
	},
	"exports": {
		"./client/*": {
			"import": "./dist/client/*/index.js",
			"types": "./dist/client/*/index.d.ts"
		},
		"./server": {
			"import": "./dist/server/index.js"
		}
	},
	"bin": {
		"copilot-ai-provider": "./dist/server/index.js"
	},
	"files": [
		"dist",
		"package.json",
		"README.md"
	]
}
