{
	"name": "copilot-ai-provider",
	"version": "0.1.0",
	"type": "module",
	"files": [
		"./dist/client/http",
		"./dist/client/standalone",
		"./dist/server"
	],
	"module": "./dist/server/index.js",
	"exports": {
		".": {
			"import": "./dist/server/index.js"
		},
		"./package.json": "./package.json"
	},
	"packageManager": "bun@1.3.9",
	"scripts": {
		"start": "bun src/server/index.ts",
		"build": "bunup",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@types/bun": "latest",
		"bunup": "^0.16.29"
	},
	"peerDependencies": {
		"typescript": "^5",
		"ai": "^6"
	},
	"dependencies": {
		"@ai-sdk/provider": "3.0.8",
		"@github/copilot-sdk": "0.1.26",
		"hono": "4.8.3",
		"zod": "4.3.6"
	}
}
