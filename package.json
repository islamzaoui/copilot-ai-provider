{
	"name": "monorepo",
	"private": true,
	"packageManager": "bun@1.3.9",
	"scripts": {
		"prepare": "husky",
		"dev": "turbo dev",
		"build": "turbo build",
		"start": "turbo start",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"lint": "biome check",
		"lint:fix": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@changesets/cli": "^2.29.8",
		"@types/bun": "1.3.9",
		"bunup": "0.16.29",
		"husky": "9.1.7",
		"lint-staged": "16.2.7",
		"turbo": "2.8.11"
	},
	"workspaces": {
		"packages": [
			"packages/*",
			"examples/*"
		],
		"catalog": {
			"ai": "^6",
			"@github/copilot-sdk": "0.1.26"
		}
	},
	"lint-staged": {
		"*": "biome check --write"
	}
